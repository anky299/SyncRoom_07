{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "entrypoint": "src/index.ts"
    },
    "frontend": {
      "root": "frontend",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_INTERNAL_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/register",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/auth/login",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/auth/spotify/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/auth/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/audio/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/socket.io",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
